# ─── Reown / WalletConnect ────────────────────────────────────────────────────
VITE_REOWN_PROJECT_ID=your_reown_project_id_here

# ─── AI Engine ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── Blockchain Explorers ─────────────────────────────────────────────────────
# Optional but improves TX lookup speed for Ethereum txs
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste private key as-is (including newlines — wrap in double quotes in shell if needed)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Admin Wallet (Backend Signing) ───────────────────────────────────────────
# Private key of the admin wallet that owns ProofClaimManager.sol
# Used by /api/weekly/settle to call setClaimable() on-chain
# NEVER commit this. Use environment variable injection in production.
ADMIN_PRIVATE_KEY=0xYOUR_ADMIN_WALLET_PRIVATE_KEY

# ─── ProofClaimManager Contract ───────────────────────────────────────────────
# Address of the deployed ProofClaimManager.sol on Celo Mainnet
# Set this AFTER deploying via Remix (see SETUP.md)
CLAIM_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# Exposed to the frontend (Vite) — same as CLAIM_CONTRACT_ADDRESS
VITE_CLAIM_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# ─── Cron Security ────────────────────────────────────────────────────────────
# Shared secret for protecting /api/hunt/judge, /api/vault/snapshot, /api/weekly/settle
# Set a long random string — e.g. openssl rand -hex 32
ADMIN_CRON_KEY=your_long_random_cron_secret_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
